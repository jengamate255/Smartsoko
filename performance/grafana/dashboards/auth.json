{
  "dashboard": {
    "title": "SmartSoko Performance Testing - Auth & User",
    "uid": "smartsoko-auth",
    "tags": ["smartsoko", "performance", "auth"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {
        "id": 1, "title": "Registration Rate", "type": "graph", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {"expr": "rate(registration_total[1m])", "legendFormat": "registrations/sec", "refId": "A"},
          {"expr": "rate(registration_failed_total[1m])", "legendFormat": "failed/sec", "refId": "B"}
        ]
      },
      {
        "id": 2, "title": "Login Rate", "type": "graph", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {"expr": "rate(login_total[1m])", "legendFormat": "logins/sec", "refId": "A"},
          {"expr": "rate(login_failed_total[1m])", "legendFormat": "failed/sec", "refId": "B"}
        ]
      },
      {
        "id": 3, "title": "Auth Latency (p50, p95, p99)", "type": "graph", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {"expr": "histogram_quantile(0.50, rate(auth_latency_seconds_bucket[1m]))", "legendFormat": "p50", "refId": "A"},
          {"expr": "histogram_quantile(0.95, rate(auth_latency_seconds_bucket[1m]))", "legendFormat": "p95", "refId": "B"},
          {"expr": "histogram_quantile(0.99, rate(auth_latency_seconds_bucket[1m]))", "legendFormat": "p99", "refId": "C"}
        ]
      },
      {
        "id": 4, "title": "Token Verification Latency", "type": "graph", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {"expr": "histogram_quantile(0.95, rate(token_verify_latency_seconds_bucket[1m]))", "legendFormat": "verify p95", "refId": "A"},
          {"expr": "histogram_quantile(0.95, rate(token_refresh_latency_seconds_bucket[1m]))", "legendFormat": "refresh p95", "refId": "B"}
        ]
      },
      {
        "id": 5, "title": "Auth Error Rate by Type", "type": "piechart", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {"expr": "rate(auth_failure_total[5m])", "legendFormat": "{{error_type}}", "refId": "A"}
        ]
      },
      {
        "id": 6, "title": "Firebase Auth Quota Usage", "type": "gauge", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {"expr": "firebase_auth_quota_used / firebase_auth_quota_limit * 100", "legendFormat": "Quota %", "refId": "A"}
        ]
      }
    ]
  },
  "overwrite": true
}