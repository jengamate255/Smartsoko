<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Theme -->
    <style name="Theme.Smartsoko" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorPrimaryVariant">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorSecondaryVariant">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <!-- Error color -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <!-- Surface variant -->
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <!-- Outline colors -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>
        <!-- Shadow and scrim -->
        <item name="colorShadow">@color/md_theme_light_shadow</item>
        <item name="colorScrim">@color/md_theme_light_scrim</item>
        <!-- Inverse colors -->
        <item name="colorInverseSurface">@color/md_theme_light_inverseSurface</item>
        <item name="colorInverseOnSurface">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorInversePrimary">@color/md_theme_light_inversePrimary</item>
        <!-- Surface tint -->
        <item name="colorSurfaceTint">@color/md_theme_light_surfaceTint</item>
        
        <!-- Custom attributes -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        
        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Smartsoko.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Smartsoko.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Smartsoko.LargeComponent</item>
    </style>
    
    <!-- Dark Theme -->
    <style name="Theme.Smartsoko.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorPrimaryVariant">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorSecondaryVariant">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <!-- Error color -->
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <!-- Surface variant -->
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <!-- Outline colors -->
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>
        <!-- Shadow and scrim -->
        <item name="colorShadow">@color/md_theme_dark_shadow</item>
        <item name="colorScrim">@color/md_theme_dark_scrim</item>
        <!-- Inverse colors -->
        <item name="colorInverseSurface">@color/md_theme_dark_inverseSurface</item>
        <item name="colorInverseOnSurface">@color/md_theme_dark_inverseOnSurface</item>
        <item name="colorInversePrimary">@color/md_theme_dark_inversePrimary</item>
        <!-- Surface tint -->
        <item name="colorSurfaceTint">@color/md_theme_dark_surfaceTint</item>
        
        <!-- Custom attributes -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        
        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Smartsoko.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Smartsoko.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Smartsoko.LargeComponent</item>
    </style>
    
    <!-- Shape Appearances -->
    <style name="ShapeAppearance.Smartsoko.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    
    <style name="ShapeAppearance.Smartsoko.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    
    <style name="ShapeAppearance.Smartsoko.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    
    <!-- Splash Screen Theme -->
    <style name="Theme.Smartsoko.Splash" parent="Theme.Smartsoko">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    
    <!-- Bottom Sheet Theme -->
    <style name="Theme.Smartsoko.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Smartsoko.BottomSheet.Modal</item>
    </style>
    
    <style name="Widget.Smartsoko.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Smartsoko.BottomSheet</item>
    </style>
    
    <style name="ShapeAppearance.Smartsoko.BottomSheet" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>
</resources>