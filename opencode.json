{
    "$schema": "https://opencode.ai/config.json",

    // SmartSoko project configuration (applies to D:\project\smartsoko and below).
    // Defaults to the local Ollama coder model. Global config lives in
    // ~/.config/opencode/opencode.json.
    "model": "ollama/qwen3.5-coder:9b",
    "default_agent": "build",

    // Extra context loaded alongside AGENTS.md.
    "instructions": ["docs/PROJECT-MAP.md", "README.md"],

    // Format files after write/edit. Built-ins only run when their binary or
    // project dependency exists (e.g. prettier, dart).
    "formatter": true,

    // Guard irreversible operations. Rules combine in order and the LAST match
    // wins, so the specific rules must follow the broad default allow.
    "permissions": [
        { "action": "shell", "resource": "git push *", "effect": "ask" },
        { "action": "shell", "resource": "git push --force*", "effect": "deny" },
        { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
        { "action": "shell", "resource": "git clean *", "effect": "deny" },
        { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
        { "action": "shell", "resource": "npm publish*", "effect": "deny" },
        { "action": "shell", "resource": "firebase deploy*", "effect": "ask" },
        { "action": "shell", "resource": "vercel *", "effect": "ask" },
        { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
        { "action": "shell", "resource": "Remove-Item *", "effect": "ask" }
    ],

    // Supabase MCP (remote, OAuth — no personal access token needed).
    // Scoped to this project so the server can only touch it. Authenticate once
    // with /mcps in OpenCode, then tools such as execute_sql / apply_migration
    // become available for running migrations.
    "mcp": {
        "servers": {
            "supabase": {
                "type": "remote",
                "url": "https://mcp.supabase.com/mcp?project_ref=vonkqyiczeqhuqhahsxm"
            }
        }
    },

    // Keep generated/build output out of the file watcher and search.
    "watcher": {
        "ignore": [
            "node_modules/**",
            "**/node_modules/**",
            "dist/**",
            "**/dist/**",
            "build/**",
            "**/build/**",
            "APK-Builds*/**",
            "temp_build_project/**",
            "**/.gradle/**",
            ".firebase/**",
            ".vercel/**",
            ".netlify/**",
            "*.log",
            "**/*.apk",
            "**/*.aab"
        ]
    }
}
