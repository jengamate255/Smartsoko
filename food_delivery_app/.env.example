# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_CALLBACK_URL=your_callback_url

# PesaPal Configuration
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENV=sandbox
PESAPAL_CALLBACK_BASE=http://localhost:3000

# nTZS Configuration (Tanzania's programmable TZS-pegged stablecoin)
NTZS_API_KEY=ntzs_test_your_test_key_here
NTZS_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NTZS_CARD_REDIRECT_URL=https://yourdomain.com/api/payments/ntzs/card-callback
NTZS_CARD_CANCEL_URL=https://yourdomain.com/api/payments/ntzs/card-callback

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Sentry Error Tracking
SENTRY_DSN=https://your-project@sentry.io/123456

# Google Gemini AI Configuration (for Product Agent)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Persist this server-only directory across restarts. Multi-host deployments
# need a shared lock-capable filesystem or a transactional DB reservation store.
# IDEMPOTENCY_DIR=/var/lib/smartsoko/idempotency
# Optional stable guest-order tracking signing secret (32+ random bytes).
# Otherwise a private key is generated in IDEMPOTENCY_DIR.
ORDER_ACCESS_SECRET=
