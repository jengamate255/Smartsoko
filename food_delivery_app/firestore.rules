rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Sellers - public read, seller-only write via ownerId match
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Products - public read, authenticated write
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Orders - authenticated only
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // Drivers - public read, driver-only write via ownerId match
    match /drivers/{driverId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Customers - public read, customer-only write via ownerId match
    match /customers/{customerId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Users - any authenticated user can read (social profiles, messaging,
    // wishlist owners); users can only write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Reviews - public read, authenticated write
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Social feed - public read, authors write their own content
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    match /post_comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // 24h stories - public read, author writes own stories
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Follows - public read, authenticated manage own follow records
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
      allow update: if false;
    }

    // Wishlists - public read (shared collections), owner writes
    match /wishlists/{wishlistId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Conversations - participants only
    match /conversations/{convId} {
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;
    }

    match /conversations/{convId}/messages/{msgId} {
      allow read, create: if isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      allow update, delete: if false;
    }

    // Order chats (customer <-> driver) - authenticated participants
    match /chats/{chatId} {
      allow read, update: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Promo codes - public read (checkout validation), authenticated write
    match /promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Merchant staff roster
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Staff invite codes (signup applies invite)
    match /staffInvites/{inviteId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Merchant payout requests
    match /payouts/{payoutId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Health check
    match /_health/{doc} {
      allow read: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
