rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // NOTE: isDriver() and isCustomer() used to sit here. Both were unused (the
    // deploy linter reported "Unused function" plus "Invalid variable name:
    // request" for them), so they were removed to keep deploys warning-free.
    // Re-add them from the driver/customer match blocks if ever needed.
    // isSeller() was retired the same way once the products rules moved to
    // ownsSeller(), which resolves the store doc's ownerId.
    
    function isOrderParticipant(order) {
      return isAuthenticated() && (
        request.auth.uid == order.get('customerId', '') ||
        request.auth.uid == order.get('driverId', '') ||
        request.auth.uid == order.get('sellerId', '') ||
        ownsCustomer(order.get('customerId', '')) ||
        ownsSeller(order.get('sellerId', ''))
      );
    }

    // Native apps reference sellers/customers by DOCUMENT ID, not by Firebase
    // uid, so participation must be resolved through the linked document's
    // ownerId field. exists() guards get() from throwing on deleted docs.
    function ownsCustomer(customerId) {
      return customerId != '' &&
        exists(/databases/$(database)/documents/customers/$(customerId)) &&
        get(/databases/$(database)/documents/customers/$(customerId)).data.get('ownerId', '') == request.auth.uid;
    }

    function ownsSeller(sellerId) {
      return sellerId != '' &&
        exists(/databases/$(database)/documents/sellers/$(sellerId)) &&
        get(/databases/$(database)/documents/sellers/$(sellerId)).data.get('ownerId', '') == request.auth.uid;
    }
    
    // Users - users can read/write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }
    
    // Customers - native customer app stores profiles under auto-issued doc
    // ids with an ownerId field; owner has full access to their own profile.
    match /customers/{customerId} {
      allow read: if isAuthenticated() &&
        (isOwner(customerId) || resource.data.get('ownerId', '') == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.get('ownerId', '') == request.auth.uid;
      allow update: if isAuthenticated() &&
        (isOwner(customerId) || resource.data.get('ownerId', '') == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    // Authoritative prices, reservations and status changes go through the API.
    // Admin SDK writes bypass these client rules.
    match /orders/{orderId} {
      // Customer app creates its own orders directly (no Admin SDK available
      // in Supabase-only mode); customerId must resolve to the caller.
      allow create: if isAuthenticated() &&
        ownsCustomer(request.resource.data.get('customerId', ''));
      // Participants can read; drivers can also read orders that are open
      // for delivery (ready_for_delivery) so they can see available jobs.
      allow read: if isOrderParticipant(resource.data) || 
        (isAuthenticated() && resource.data.get('status', '') == 'ready_for_delivery');
      allow update: if isAuthenticated() && (
        // customer manages own order (cancel, rating)
        ownsCustomer(resource.data.get('customerId', '')) ||
        // merchant manages orders of own store (accept, ready)
        ownsSeller(resource.data.get('sellerId', '')) ||
        // assigned driver progresses the delivery
        request.auth.uid == resource.data.get('driverId', '') ||
        // driver claims an open job, touching only claim fields
        (resource.data.get('status', '') == 'ready_for_delivery' &&
          request.resource.data.get('driverId', '') == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['driverId', 'driverName', 'driverPhone', 'status', 'assignedAt', 'acceptedAt', 'updatedAt', 'pickedUpAt']
          ))
      );
      allow delete: if false;
    }
    
    // Drivers - owner manages their own profile/availability/location.
    // Merchants/admins may flip availability fields when assigning jobs.
    // Canonical layout is drivers/{uid}; web-created docs sometimes lack an
    // explicit ownerId, so the document id itself is an ownership fallback.
    //
    // READ is scoped to the driver themselves or an admin. Letting every
    // authenticated user read every driver profile exposed phone numbers and
    // live locations to the world; merchants interact with drivers via the
    // orders collection, not by reading driver docs directly.
    match /drivers/{driverId} {
      allow read: if request.auth.uid == driverId || isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        driverId == request.auth.uid ||
        request.resource.data.get('ownerId', '') == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['available', 'currentOrderId', 'updatedAt']
        )
      );
      allow delete: if isAdmin();
    }
    
    // Products - authenticated read (native apps and the PWA sign in before
    // browsing), sellers write their own. The native merchant app stores the
    // store's document id in "merchantId"; legacy/web rows used "sellerId"
    // equal to the owner uid. Accept both.
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.get('sellerId', '') == request.auth.uid ||
        ownsSeller(request.resource.data.get('merchantId', ''))
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.get('sellerId', '') == request.auth.uid ||
        ownsSeller(resource.data.get('sellerId', '')) ||
        ownsSeller(resource.data.get('merchantId', ''))
      );
    }
    
    // Carts - user owns their cart
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Addresses - user owns their addresses
    match /addresses/{addressId} {
      allow read, write: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isOwner(resource.data.userId));
    }
    
    // Payments - user reads their own payments; writes go through the PesaPal/
    // escrow API (Admin SDK). Letting any authenticated user create a payments
    // row with an arbitrary userId let anyone forge a "paid" record against
    // another user's account.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create, update, write: if false;
    }
    
    // Notifications - user owns their notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }
    
    // Referrals - users read their own (as referrer or referee); writes go
    // through the API. Letting any authenticated user create a referral row
    // with an arbitrary referrerId let anyone credit themselves rewards for
    // inviting another user.
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.referrerId || 
         request.auth.uid == resource.data.refereeId || 
         isAdmin());
      allow create, update, write: if false;
    }
    
    // Reviews - authenticated read, users create their own; sellers reply to
    // their own.
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.sellerId || isAdmin());
      allow delete: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }
    
    // Sellers - owner can manage, authenticated users can read (storefront
    // needs to list merchants). Create is scoped so a user can only claim the
    // seller doc whose id equals their own uid — without this, any signed-in
    // user could squat on an unclaimed sellerId and impersonate a merchant.
    match /sellers/{sellerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (sellerId == request.auth.uid || isAdmin());
      allow update, delete: if isOwner(sellerId) || isAdmin();
    }
    
    // Riders/Drivers - owner can manage, admins can read all
    match /riders/{riderId} {
      allow read: if isAuthenticated() && (isOwner(riderId) || isAdmin());
      allow create, update: if isOwner(riderId) || isAdmin();
    }
    
    // Wallet - user reads their own balance; writes go through the escrow API
    // (Admin SDK), never directly from the client. Letting clients write their
    // own wallet doc contradicted the escrow model and let anyone credit
    // themselves by posting `{ balance: 99999 }`.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }
    
    // Transactions - user reads their own; writes go through the escrow API.
    // Same forgery risk as /payments if clients could create rows freely.
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create, update, write: if false;
    }
    
    // Categories - authenticated read, admin write
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Flash Deals - authenticated read, admin write
    match /flashDeals/{dealId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Deals - authenticated read, merchant/admin write
    match /deals/{dealId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || 
        (isAuthenticated() && request.resource.data.merchantId == request.auth.uid);
    }
    
    // Gift Cards - buyer/recipient read their own; writes go through the API
    // (Admin SDK). Letting any authenticated user create a giftCards row with
    // an arbitrary balance let anyone mint themselves credit.
    match /giftCards/{cardId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.purchaserId || 
         request.auth.uid == resource.data.recipientId ||
         isAdmin());
      allow create, update, write: if false;
    }
    
    // Subscriptions - user owns their subscriptions
    match /subscriptions/{subscriptionId} {
      allow read, write: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }
    
    // Webhooks - admin only
    match /webhooks/{webhookId} {
      allow read, write: if isAdmin();
    }
    
    // Analytics - admin only
    match /analytics/{analyticsId} {
      allow read: if isAdmin();
    }
    
    // ── Collections the client reads that had NO rule of their own ───────
    // These were only ever readable through the catch-all that used to sit at
    // the bottom of this file (see the note below). Removing the catch-all
    // without these blocks would break the customer storefront menu, checkout
    // promo codes, chat/driver messages and the restaurant/staff pages —
    // verified with scratch/audit-rules-coverage.cjs.
    //
    // They deliberately grant READ ONLY, exactly matching what the catch-all
    // granted: writes to these collections are (and were) denied, because the
    // catch-all never allowed writes either. Tightening chat/messages to their
    // participants is a sensible follow-up but needs the document shapes first.
    match /menuItems/{menuItemId} {
      allow read: if isAuthenticated();
    }
    match /menu_items/{menuItemId} {
      allow read: if isAuthenticated();
    }
    match /restaurants/{restaurantId} {
      allow read: if isAuthenticated();
    }
    match /promotions/{promotionId} {
      allow read: if isAuthenticated();
    }
    match /chats/{chatId} {
      allow read: if isAuthenticated();
    }
    match /messages/{messageId} {
      allow read: if isAuthenticated();
    }
    match /staff/{staffId} {
      allow read: if isAuthenticated();
    }
    match /staffInvites/{inviteId} {
      allow read: if isAuthenticated();
    }

    // REMOVED: a catch-all read rule used to live here:
    //   match /{document=**} { allow read: if isAuthenticated(); }
    // Firestore rules are additive (OR), so that wildcard granted EVERY
    // signed-in user read access to every collection — orders, payments,
    // wallets, user profiles and customer PII — regardless of the ownership
    // rules above it. Its legitimate effects are enumerated above; do NOT
    // re-add a wildcard read rule.
  }
}
