<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme with Material 3 colors via AppCompat -->
    <style name="Theme.SmartSokoDriver" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color (Tanzania orange) -->
        <item name="colorPrimary">@color/primary_orange</item>
        <item name="colorPrimaryDark">@color/primary_orange_dark</item>
        <item name="colorAccent">@color/primary_green</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorControlNormal">@color/on_surface_light</item>
        <item name="colorControlActivated">@color/primary_orange</item>
        <item name="colorControlHighlight">@color/primary_orange_light</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_orange</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        
        <!-- Typography -->
        <item name="android:textColorPrimary">@color/on_background_light</item>
        <item name="android:textColorSecondary">@color/on_surface_variant_light</item>
        
        <!-- Window -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Splash screen -->
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
    
    <style name="Theme.SmartSokoDriver.NoActionBar" parent="Theme.SmartSokoDriver" />
    
    <!-- Splash screen theme -->
    <style name="Theme.SmartSokoDriver.Splash" parent="Theme.SmartSokoDriver">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>